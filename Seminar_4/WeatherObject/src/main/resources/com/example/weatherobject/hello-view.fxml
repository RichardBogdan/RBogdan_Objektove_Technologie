<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>

<Pane fx:id="root" prefWidth="500.0" prefHeight="580.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.weatherobject.HelloController">

  <Button layoutX="10.0" layoutY="10.0" text="Oblak" onAction="#onClickCloud"/>
  <Button layoutX="80.0" layoutY="10.0" text="Kvapka" onAction="#onClickRaindrop"/>
  <Button layoutX="160.0" layoutY="10.0" text="Vločka" onAction="#onClickSnowflake"/>

  <Button layoutX="10.0" layoutY="45.0" text="Zastav dážď" onAction="#zastavDazd"/>
  <Button layoutX="120.0" layoutY="45.0" text="Oblaky modré" onAction="#zmenFarbuOblakov"/>
  <Button layoutX="240.0" layoutY="45.0" text="Posun o 20 px doľava" onAction="#posunDolava"/>
</Pane>